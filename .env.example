# MCP Assistant Demo — copy to .env and fill in your model key

DOCUMENT_RAG_ENABLED=true
BUSINESS_QUERY_MODE=enabled
CHAT_PROVIDER=openai
RETRIEVER_KIND=chroma
CORPUS_SOURCE=local
CORPUS_DIR=data/corpus/company

RAG_JWT_SECRET=change-me-to-a-long-random-secret
RAG_JWT_ISS=laravel-billing
RAG_JWT_AUD=rag-service
REDACTION_HMAC_KEY=change-me-to-another-long-random-secret

BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=

QUERY_RECORD_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/query_records
MCP_RECORD_DATABASE_URL=mysql+pymysql://demo:demo@mariadb:3306/mcp_demo
REDIS_URL=redis://redis:6379/0

CONVERSATION_ENABLED=true
CONVERSATION_COORDINATOR_ENABLED=true
ENVIRONMENT=development
