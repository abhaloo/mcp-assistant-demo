# Public Demo Billing Environment Configuration
# Copy to billing.env on the host (not committed to git)

APP_NAME="Bloomfield Print Works"
APP_ENV=production
APP_KEY=base64:change-me-to-a-valid-32-byte-base64-key=====
APP_DEBUG=false
APP_URL=https://demo.example.com

LOG_CHANNEL=stack
LOG_LEVEL=info

# Database connection to the internal MariaDB service
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=mcp_demo
DB_USERNAME=demo
DB_PASSWORD=change-me-demo-password

# Cache, session, and queue
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

HEALTH_CHECK_REDIS=true

# Ask AI integration and spend caps
RAG_SERVICE_URL=http://rag-api:8000
RAG_SEARCH_ENABLED=true
RAG_ASK_V2_ENABLED=true
RAG_AI_MONTHLY_CAP=5
RAG_AI_CREDITS_CHARGE_V2=true
RAG_ASK_BUDGET_CLAIM=true

# Shared JWT secret between billing and RAG API
RAG_JWT_SECRET=change-me-to-a-long-random-secret
RAG_JWT_ISS=laravel-billing
RAG_JWT_AUD=rag-service
