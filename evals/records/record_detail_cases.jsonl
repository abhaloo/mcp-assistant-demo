{"id": "rec-cust-01", "split": "dev", "stratum": "customer_detail", "question": "Show me customer 301's contact info", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view customer contact"]}, "adapter": "CustomerDetailAdapter", "action": "get_customer_detail", "params": {"customer_id": 301, "entity_id": 1}, "expect": "resolved", "oracle": {"id": 301, "name": "Acme Packaging Ltd", "phone": "555-0101", "email": "ops@acmepackaging.com", "tax_number": null, "balance_owing": null}, "gold_note": "Principal has view customer contact; phone/email resolved, tax/financial masked"}
{"id": "rec-cust-02", "split": "dev", "stratum": "customer_detail", "question": "Show me customer 301 details without contact permission", "principal": {"entity_id": 1, "cross_entity": false, "permissions": []}, "adapter": "CustomerDetailAdapter", "action": "get_customer_detail", "params": {"customer_id": 301, "entity_id": 1}, "expect": "resolved", "oracle": {"id": 301, "name": "Acme Packaging Ltd", "phone": null, "email": null, "tax_number": null, "balance_owing": null}, "gold_note": "Contact permission omitted; phone and email masked as None"}
{"id": "rec-cust-03", "split": "dev", "stratum": "customer_detail", "question": "Show me customer 301 financial balance", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view customer financial"]}, "adapter": "CustomerDetailAdapter", "action": "get_customer_detail", "params": {"customer_id": 301, "entity_id": 1}, "expect": "resolved", "oracle": {"id": 301, "name": "Acme Packaging Ltd", "phone": null, "email": null, "tax_number": "TAX-ACME-01", "balance_owing": 15420.50}, "gold_note": "Principal has view customer financial; tax_number and balance_owing populated"}
{"id": "rec-cust-04", "split": "dev", "stratum": "customer_detail", "question": "Tenant 1 attempting to fetch Tenant 2 customer 399", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view customer contact", "view customer financial"]}, "adapter": "CustomerDetailAdapter", "action": "get_customer_detail", "params": {"customer_id": 399, "entity_id": 1}, "expect": "empty", "oracle": null, "gold_note": "Multi-tenant boundary: requesting customer 399 with entity_id=1 returns None"}
{"id": "rec-ord-01", "split": "dev", "stratum": "order_status_authority", "question": "Show order 501 with its jobs and invoices", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view customer order", "view job", "view invoice"]}, "adapter": "CustomerOrderDetailAdapter", "action": "get_order_detail", "params": {"order_id": 501, "entity_id": 1}, "expect": "resolved", "oracle": {"id": 501, "order_number": "ORD-2026-0501", "status": "CREATED", "jobs_count": 2, "invoices_count": 2, "job_numbers": ["JOB-101", "JOB-102"], "invoice_numbers": ["INV-2026-801", "INV-2026-802"]}, "gold_note": "Parent-grain reconciliation: exactly 2 jobs and 2 invoices, no Cartesian fan-out"}
{"id": "rec-ord-02", "split": "dev", "stratum": "order_status_authority", "question": "Validate order status lifecycle transition rules", "principal": {"entity_id": 1, "cross_entity": false, "permissions": []}, "adapter": "CustomerOrderDetailAdapter", "action": "validate_transitions", "params": {}, "expect": "resolved", "oracle": {"created_to_active": true, "created_to_cancelled": true, "active_to_finished": true, "finished_to_active": false, "cancelled_to_active": false}, "gold_note": "Canonical status authority rules: finished and cancelled are immutable terminal states"}
{"id": "rec-ord-03", "split": "dev", "stratum": "order_status_authority", "question": "Tenant 1 requesting Tenant 2 order 599", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view customer order"]}, "adapter": "CustomerOrderDetailAdapter", "action": "get_order_detail", "params": {"order_id": 599, "entity_id": 1}, "expect": "empty", "oracle": null, "gold_note": "Tenant isolation: order 599 belongs to entity 2, returns None for entity 1"}
{"id": "rec-inv-01", "split": "dev", "stratum": "invoice_quotation", "question": "Show invoice 801 details with line items", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view invoice"]}, "adapter": "InvoiceDetailAdapter", "action": "read_bill_details", "params": {"resource_type": "invoice", "parent_ids": [801], "include_line_items": true}, "expect": "resolved", "oracle": {"id": 801, "invoice_number": "INV-801", "status": "POSTED", "items_total": 4500.0, "cash_received": 2500.0, "receivable_settlement": 2500.0, "outstanding": 2000.0, "days_past_due": 45, "line_items_count": 2}, "gold_note": "Invoice line item grain preserved via bill_item_fact"}
{"id": "rec-inv-02", "split": "dev", "stratum": "invoice_quotation", "question": "Show open quotations", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view quotation"]}, "adapter": "InvoiceDetailAdapter", "action": "read_open_quotations", "params": {"parent_ids": [802, 803]}, "expect": "resolved", "oracle": {"open_ids": [802]}, "gold_note": "Open quotations filter selects status OPEN (802) and excludes CONVERTED (803)"}
{"id": "rec-inv-03", "split": "dev", "stratum": "invoice_quotation", "question": "Show converted quotations", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view quotation"]}, "adapter": "InvoiceDetailAdapter", "action": "read_converted_quotations", "params": {"parent_ids": [802, 803]}, "expect": "resolved", "oracle": {"converted_ids": [803]}, "gold_note": "Converted quotations filter selects CONVERTED quote 803"}
{"id": "rec-mat-01", "split": "dev", "stratum": "materials_inventory", "question": "What materials are planned for job 101?", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view job"]}, "adapter": "JobPlannedMaterialAdapter", "action": "get_planned_materials", "params": {"job_id": 101, "entity_id": 1}, "expect": "resolved", "oracle": {"item_count": 2, "products": ["100lb Gloss Text Paper", "Cyan Process Ink"], "quantities": [5000.0, 4.0]}, "gold_note": "Planned materials sourced from work_order_items estimates"}
{"id": "rec-mat-02", "split": "dev", "stratum": "materials_inventory", "question": "What materials were actually issued for job 101?", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view job", "view inventory"]}, "adapter": "JobIssuedMaterialAdapter", "action": "get_issued_materials", "params": {"job_id": 101, "entity_id": 1}, "expect": "resolved", "oracle": {"item_count": 1, "products": ["100lb Gloss Text Paper"], "quantities": [5200.0], "batch_number": "B-PAP-2026-01"}, "gold_note": "Issued materials strictly separated from planned materials; reads inventory_issues"}
{"id": "rec-mat-03", "split": "dev", "stratum": "materials_inventory", "question": "Show inventory item 401 without cost permission", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view inventory"]}, "adapter": "InventoryDetailAdapter", "action": "get_inventory", "params": {"inventory_id": 401, "entity_id": 1}, "expect": "resolved", "oracle": {"id": 401, "product_name": "100lb Gloss Text Paper", "quantity_on_hand": 25000.0, "unit_cost": null, "total_valuation": null}, "gold_note": "Cost permission missing: unit_cost and total_valuation masked as None"}
{"id": "rec-mat-04", "split": "dev", "stratum": "materials_inventory", "question": "Show inventory item 401 with cost permission", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view inventory", "view inventory cost"]}, "adapter": "InventoryDetailAdapter", "action": "get_inventory", "params": {"inventory_id": 401, "entity_id": 1}, "expect": "resolved", "oracle": {"id": 401, "product_name": "100lb Gloss Text Paper", "quantity_on_hand": 25000.0, "unit_cost": 0.15, "total_valuation": 3750.0}, "gold_note": "Cost permission present: unit_cost=0.15, total_valuation=3750.0 populated"}
{"id": "rec-mat-05", "split": "dev", "stratum": "materials_inventory", "question": "Show artwork for job 101", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view job"]}, "adapter": "JobArtworkAdapter", "action": "get_artwork_metadata", "params": {"job_id": 101, "entity_id": 1}, "expect": "resolved", "oracle": {"file_name": "proof_final_v2.pdf", "status": "APPROVED", "storage_path_absent": true, "s3_key_absent": true, "signed_url_absent": true}, "gold_note": "Artwork security: file_name sanitized to basename proof_final_v2.pdf, sensitive storage keys prohibited"}
{"id": "rec-prod-01", "split": "dev", "stratum": "product_supplier", "question": "Show product 501 details", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view product"]}, "adapter": "ProductDetailAdapter", "action": "get_product", "params": {"product_id": 501, "entity_id": 1}, "expect": "resolved", "oracle": {"id": 501, "name": "100lb Gloss Text Paper", "sku": "PAP-GLOSS-100", "category": "Paper", "unit_price": 0.25}, "gold_note": "Product catalog lookup with view product permission"}
{"id": "rec-prod-02", "split": "dev", "stratum": "product_supplier", "question": "Show supplier 701 details", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view supplier"]}, "adapter": "SupplierDetailAdapter", "action": "get_supplier", "params": {"supplier_id": 701, "entity_id": 1}, "expect": "resolved", "oracle": {"id": 701, "name": "National Paper Mills Inc", "code": "SUP-NPM-01", "payment_terms": "Net 30"}, "gold_note": "Supplier catalog lookup with view supplier permission"}
{"id": "rec-prod-03", "split": "dev", "stratum": "product_supplier", "question": "Tenant 1 requesting Tenant 2 product 699", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view product"]}, "adapter": "ProductDetailAdapter", "action": "get_product", "params": {"product_id": 699, "entity_id": 1}, "expect": "empty", "oracle": null, "gold_note": "Cross-tenant isolation: requesting entity 2 product with entity_id=1 returns None"}
{"id": "rec-prod-04", "split": "dev", "stratum": "product_supplier", "question": "Tenant 1 principal attempting to pass entity_id=2", "principal": {"entity_id": 1, "cross_entity": false, "permissions": ["view product"]}, "adapter": "ProductDetailAdapter", "action": "get_product", "params": {"product_id": 699, "entity_id": 2}, "expect": "denied", "oracle": {"exception": "ScopeDenied"}, "gold_note": "Tenant boundary guard: entity_id mismatch against non-cross-entity principal raises ScopeDenied"}
