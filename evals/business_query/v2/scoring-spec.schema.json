{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-connect.local/business-query/scoring-spec.schema.json",
  "title": "Frozen Business Query case scoring spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "review_status",
    "reviewed_by",
    "reviewed_at",
    "member_mappings",
    "row_key",
    "expected_row_count",
    "expected_total_row_count",
    "expected_truncated"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "review_status": {"const": "approved"},
    "reviewed_by": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "member_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["oracle_column", "result_member", "value_kind"],
        "properties": {
          "oracle_column": {"type": "string", "minLength": 1},
          "result_member": {"type": "string", "minLength": 1},
          "result_member_alternatives": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1},
            "default": []
          },
          "value_kind": {"enum": ["currency", "non_money"]}
        }
      }
    },
    "row_key": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_row_count": {"type": "integer", "minimum": 0},
    "expected_total_row_count": {"type": "integer", "minimum": 0},
    "expected_truncated": {"type": "boolean"},
    "ordered": {"type": "boolean", "default": false},
    "metadata_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "default": []
    }
  }
}
