# Public Demo RAG Environment Configuration
# Copy to rag.env on the host (not committed to git)

API_TITLE="Bloomfield Print Works"
# Redis runs on the internal Docker network only; production mode would require TLS Redis.
ENVIRONMENT=development

DOCUMENT_RAG_ENABLED=true
BUSINESS_QUERY_MODE=enabled
CHAT_PROVIDER=openai
RETRIEVER_KIND=chroma
CORPUS_SOURCE=local
CORPUS_DIR=data/corpus/company

# Shared authentication secrets with billing
RAG_JWT_SECRET=change-me-to-a-long-random-secret
RAG_JWT_ISS=laravel-billing
RAG_JWT_AUD=rag-service
REDACTION_HMAC_KEY=change-me-to-another-long-random-secret

# Provider API keys (fill in host rag.env only; never commit real keys)
BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
OPENAI_API_KEY=
TYPESAFE_API_KEY=

# Input safety screening and budget controls
ASK_INPUT_SCREEN_MODE=block
ASK_ACCOUNT_BUDGET_ENABLED=true

# Database and cache connections
QUERY_RECORD_DATABASE_URL=postgresql+asyncpg://postgres:change-me-postgres@postgres:5432/query_records
MCP_RECORD_DATABASE_URL=mysql+pymysql://demo:change-me-demo@mariadb:3306/mcp_demo
REDIS_URL=redis://redis:6379/0

# Conversation coordinator
CONVERSATION_ENABLED=true
CONVERSATION_COORDINATOR_ENABLED=true

# Ask v2 readiness (Gate C). The v2 Ask route refuses every turn until all of these are set.
# A fresh database has an empty invocation ledger, so the backfill receipt is the zero-row receipt below.
# Generate the keyring once per deployment:
#   python -c "import base64,json,secrets;print(json.dumps({'current':'v1','keys':{'v1':base64.b64encode(secrets.token_bytes(32)).decode()}},separators=(',',':')))"
CANARY_ENCRYPTION_READY=true
GATE_B_NEW_WRITE_READY=true
ZERO_PLAINTEXT_BACKFILL_RECEIPT={"encrypted_count":0,"error_count":0,"verified":true,"key_version":"v1"}
BUSINESS_QUERY_EVENT_PAYLOAD_MODE=encrypted
BUSINESS_QUERY_EVENT_ENCRYPTION_KEYS=
ASK_RESULT_PAGE_ENABLED=true

# Versioned tool layer: needed for record links and for restoring answers after a page change.
# The SHA is of config/document-tool-profile.json as shipped in this repository.
ASK_TOOL_LAYER_ENABLED=true
ASK_TOOL_LAYER_PROFILE_SHA256=bbd411cfae4381455b79dd9b652f7dea100d84249d4fff5e1406bcb159ab57ee
